# Copy this file to .env and fill in the values from your Firebase
# project's web app config (Firebase Console -> Project Settings ->
# General -> Your apps -> SDK setup and configuration).
#
# Note: these Firebase "config" values are not secret in the way an
# API key for a traditional backend is - they're safe to ship in a
# public frontend bundle. Real security comes from firestore.rules
# and storage.rules (see those files), not from hiding these values.
# Still kept in .env rather than hardcoded so dev/staging/prod can
# point at different Firebase projects without code changes.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Leave all of the above blank to run in local-only demo mode
# (browser localStorage instead of Firebase) - see README's
# "Part 8: Admin Dashboard" section.
