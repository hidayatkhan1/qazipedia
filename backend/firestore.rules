rules_version = '2';

// Planned schema once adminStorage.js is swapped from localStorage to
// Firestore (see DEPLOYMENT.md "Wiring the real backend" section):
//
//   uploads/{autoId}
//     sectionKey, resourceType, title, note, filterValue, filterLabel,
//     fileName, fileUrl, uploadedAt
//
//   resultDocuments/{compositeKey}
//     (compositeKey = "region::institute::program::semester::session",
//     matching the key format already used in the localStorage version)
//     fileName, fileUrl, pageCount, fileSizeKB, studentCount,
//     regionName, instituteName, region, institute, program,
//     semester, session, uploadedDate
//
// Everyone can read (visitors browsing the site need this data).
// Only a signed-in user can write (you'll create exactly one admin
// account by hand in Firebase Console -> Authentication -> Add user,
// rather than allowing public sign-up).

service cloud.firestore {
  match /databases/{database}/documents {
    match /uploads/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /resultDocuments/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
