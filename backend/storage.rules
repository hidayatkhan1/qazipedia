rules_version = '2';

// Uploaded files (PDFs, slide decks, etc.) live under /uploads/ and
// /results/ in Storage once the real upload flow is wired up (right
// now the admin form only captures a file *name*, not its bytes).
// Same access pattern as Firestore: public read, admin-only write.
// Storage also enforces a size cap here so one upload can't blow
// through your Firebase plan's storage/bandwidth by accident.

service firebase.storage {
  match /b/{bucket}/o {
    match /uploads/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 25 * 1024 * 1024; // 25MB cap
    }
    match /results/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 25 * 1024 * 1024;
    }
  }
}
